{% style %}
  {% if block.settings.add-text-color %}
    .custom-text-color-{{ block.id }} {
      color: #BD3D44;
    }

    {% endif %}
{% endstyle %}

<div class="o-layout__item u-1/1 u-{{ block.settings.width }}@tab" {{ block.shopify_attributes }}>
  <div
    class="custom-content__item custom-content__item--text"
    {{ block.shopify_attributes }}
  >
    <div class="custom-content__item-content custom-content__item-content--text{% if block.settings.align == 'center' %} u-text-center{% endif %}">
      {% unless block.settings.title == blank %}
        <div
          class="section__title section__title--mb-s{% if block.settings.align == 'center' %} section__title--center{% endif %} js-animate-single"
          data-animation-displacement="5"
        >
          <h2 class="section__title-text">{{ block.settings.title | escape }}</h2>
        </div>
      {% endunless %}
      {% unless block.settings.text == blank %}
        <div class="custom-text-color-{{ block.id }} custom-content__item-text rte">
          {{ block.settings.text }}
        </div>
      {% endunless %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Text",
  "tag": null,
  "settings": [
    {
      "type": "checkbox",
      "id": "add-text-color",
      "label": "Add text color"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Text"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Promote your brand by using a powerful combination of buttons, custom text, page content and images.</p>"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Text alignment",
      "default": "center",
      "options": [
        {
          "label": "Center",
          "value": "center"
        },
        {
          "label": "Left",
          "value": "left"
        }
      ]
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "1/2",
      "options": [
        {
          "label": "Full width",
          "value": "1/1"
        },
        {
          "label": "One half",
          "value": "1/2"
        },
        {
          "label": "One third",
          "value": "1/3"
        },
        {
          "label": "One fourth",
          "value": "1/4"
        },
        {
          "label": "Two thirds",
          "value": "2/3"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Text"
    }
  ]
}
{% endschema %}
